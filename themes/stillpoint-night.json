  "tokenColors": [
    {
      "name": "Explanatory text",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#AAB8C4",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#BED99A",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#EAC08F",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and declaration",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C6B0F5",
        "fontStyle": ""
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.name.class",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#78D8CB",
        "fontStyle": ""
      }
    },
    {
      "name": "Calls",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#A4CAFF",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#E6EBEF",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties and keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "support.type.property-name.json",
        "entity.other.attribute-name",
        "meta.object-literal.key",
        "meta.mapping.key string"
      ],
      "settings": {
        "foreground": "#D6DFE8",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#C7D5E2",
        "fontStyle": ""
      }
    },
    {
      "name": "Namespaces and labels",
      "scope": [
        "entity.name.namespace",
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#D6DFE8",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#B9C6D1",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and interpolation delimiters",
      "scope": [
        "constant.character.escape",
        "punctuation.section.interpolation",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#C6B0F5",
        "fontStyle": ""
      }
    },
    {
      "name": "Regexp operators",
      "scope": [
        "keyword.operator.regexp",
        "keyword.operator.quantifier.regexp",
        "punctuation.definition.character-class.regexp"
      ],
      "settings": {
        "foreground": "#C6B0F5",
        "fontStyle": ""
      }
    },
    {
      "name": "Configuration sections",
      "scope": [
        "entity.name.section",
        "entity.name.namespace.site-address.caddyfile"
      ],
      "settings": {
        "foreground": "#78D8CB",
        "fontStyle": ""
      }
    },
    {
      "name": "Configuration variables",
      "scope": [
        "variable.other.systemd.specifier",
        "variable.other.systemd.environment",
        "variable.other.placeholder.caddyfile",
        "variable.other.environment.caddyfile",
        "variable.other.environment.vhs"
      ],
      "settings": {
        "foreground": "#C7D5E2",
        "fontStyle": ""
      }
    },
    {
      "name": "Configuration paths",
      "scope": [
        "string.unquoted.path.logrotate",
        "string.quoted.path.logrotate"
      ],
      "settings": {
        "foreground": "#BED99A",
        "fontStyle": ""
      }
    },
    {
      "name": "Configuration identities",
      "scope": [
        "entity.name.user.logrotate",
        "entity.name.group.logrotate"
      ],
      "settings": {
        "foreground": "#D6DFE8",
        "fontStyle": ""
      }
    },
    {
      "name": "Configuration units",
      "scope": [
        "keyword.other.unit.logrotate",
        "keyword.other.unit.vhs"
      ],
      "settings": {
        "foreground": "#EAC08F",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#E6EBEF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "markup.underline.link.image"
      ],
      "settings": {
        "foreground": "#78D8CB",
        "fontStyle": "underline"
