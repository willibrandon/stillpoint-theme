  "tokenColors": [
    {
      "name": "Explanatory text",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#CAD6DF",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#D4EDAF",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#FFD5A6",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and declaration",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#DDC5FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.name.class",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#93F5E4",
        "fontStyle": ""
      }
    },
    {
      "name": "Calls",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#BCDFFF",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties and keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "support.type.property-name.json",
        "entity.other.attribute-name",
        "meta.object-literal.key",
        "meta.mapping.key string"
      ],
      "settings": {
        "foreground": "#F3F7FA",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#E0EBF5",
        "fontStyle": ""
      }
    },
    {
      "name": "Namespaces and labels",
      "scope": [
        "entity.name.namespace",
        "entity.name.label"
