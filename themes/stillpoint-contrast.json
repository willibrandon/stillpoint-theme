      ],
      "settings": {
        "foreground": "#FFB7C2",
        "fontStyle": ""
      }
    },
    {
      "name": "Changed lines",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#FFE2A1",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid syntax",
      "scope": [
        "invalid.illegal"
      ],
