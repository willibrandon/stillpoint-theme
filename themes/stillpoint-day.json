  "tokenColors": [
    {
      "name": "Explanatory text",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#2B343C",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#2A3814",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#4A2C0F",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and declaration",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#3F275F",
        "fontStyle": ""
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.name.class",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#003D39",
        "fontStyle": ""
      }
    },
    {
      "name": "Calls",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#15355A",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#26333D",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties and keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "support.type.property-name.json",
        "entity.other.attribute-name",
        "meta.object-literal.key",
        "meta.mapping.key string"
      ],
      "settings": {
        "foreground": "#233542",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#2A3440",
        "fontStyle": ""
      }
    },
    {
      "name": "Namespaces and labels",
      "scope": [
        "entity.name.namespace",
        "entity.name.label"
