  "tokenColors": [
    {
      "name": "Explanatory text",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#4D5F6C",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#496424",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#83501B",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and declaration",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#6943A0",
        "fontStyle": ""
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.name.class",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#00675F",
        "fontStyle": ""
      }
    },
    {
      "name": "Calls",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#245995",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#26333D",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties and keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "support.type.property-name.json",
        "entity.other.attribute-name",
        "meta.object-literal.key",
        "meta.mapping.key string"
      ],
      "settings": {
        "foreground": "#344E60",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#46576B",
        "fontStyle": ""
      }
    },
    {
      "name": "Namespaces and labels",
      "scope": [
        "entity.name.namespace",
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#344E60",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#485C69",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and interpolation delimiters",
      "scope": [
        "constant.character.escape",
        "punctuation.section.interpolation",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#6943A0",
        "fontStyle": ""
      }
    },
    {
      "name": "Regexp operators",
      "scope": [
        "keyword.operator.regexp",
        "keyword.operator.quantifier.regexp",
        "punctuation.definition.character-class.regexp"
      ],
      "settings": {
        "foreground": "#6943A0",
        "fontStyle": ""
      }
    },
    {
      "name": "Configuration sections",
      "scope": [
        "entity.name.section",
        "entity.name.namespace.site-address.caddyfile"
      ],
      "settings": {
        "foreground": "#00675F",
        "fontStyle": ""
      }
    },
    {
      "name": "Configuration variables",
      "scope": [
        "variable.other.systemd.specifier",
        "variable.other.systemd.environment",
        "variable.other.placeholder.caddyfile",
        "variable.other.environment.caddyfile",
        "variable.other.environment.vhs"
      ],
      "settings": {
        "foreground": "#46576B",
        "fontStyle": ""
      }
    },
    {
      "name": "Configuration paths",
      "scope": [
        "string.unquoted.path.logrotate",
        "string.quoted.path.logrotate"
      ],
      "settings": {
        "foreground": "#496424",
        "fontStyle": ""
      }
    },
    {
      "name": "Configuration identities",
      "scope": [
        "entity.name.user.logrotate",
        "entity.name.group.logrotate"
      ],
      "settings": {
        "foreground": "#344E60",
        "fontStyle": ""
      }
    },
    {
      "name": "Configuration units",
      "scope": [
        "keyword.other.unit.logrotate",
        "keyword.other.unit.vhs"
      ],
      "settings": {
        "foreground": "#83501B",
        "fontStyle": ""
