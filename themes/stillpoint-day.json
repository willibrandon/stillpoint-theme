        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#26333D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "markup.underline.link.image"
      ],
      "settings": {
        "foreground": "#00675F",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#26333D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#26333D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block punctuation.definition"
      ],
      "settings": {
        "foreground": "#496424",
        "fontStyle": ""
      }
    },
    {
      "name": "Added lines",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#276B47",
        "fontStyle": ""
      }
    },
    {
      "name": "Removed lines",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#AB2946",
        "fontStyle": ""
      }
    },
    {
      "name": "Changed lines",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#795300",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid syntax",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#AB2946",
        "fontStyle": "underline"
      }
    }
  ],
