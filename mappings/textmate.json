[
  {
    "name": "Explanatory text",
    "scope": [
      "comment",
      "punctuation.definition.comment"
    ],
    "settings": {
      "foreground": "$comment",
      "fontStyle": ""
    }
  },
  {
    "name": "Strings",
    "scope": [
      "string"
    ],
    "settings": {
      "foreground": "$string",
      "fontStyle": ""
    }
  },
  {
    "name": "Numbers and constants",
    "scope": [
      "constant.numeric",
      "constant.language"
    ],
    "settings": {
      "foreground": "$number",
      "fontStyle": ""
    }
  },
  {
    "name": "Keywords and declaration",
    "scope": [
      "keyword",
      "storage.type",
      "storage.modifier"
    ],
    "settings": {
      "foreground": "$keyword",
      "fontStyle": ""
    }
  },
  {
    "name": "Types",
    "scope": [
      "entity.name.type",
      "support.type",
      "support.class",
      "entity.name.class",
      "entity.name.tag"
    ],
    "settings": {
      "foreground": "$type",
      "fontStyle": ""
    }
  },
  {
    "name": "Calls",
    "scope": [
      "entity.name.function",
      "support.function"
    ],
    "settings": {
      "foreground": "$function",
      "fontStyle": ""
    }
  },
  {
    "name": "Variables",
    "scope": [
      "variable.other.readwrite",
      "variable.other.object",
      "variable.other.constant",
      "variable.language"
    ],
    "settings": {
      "foreground": "$fg",
      "fontStyle": ""
    }
  },
  {
    "name": "Properties and keys",
    "scope": [
      "variable.other.property",
      "variable.other.object.property",
      "support.type.property-name",
      "support.type.property-name.json",
      "entity.other.attribute-name",
      "meta.object-literal.key",
      "meta.mapping.key string"
    ],
    "settings": {
      "foreground": "$property",
      "fontStyle": ""
    }
  },
  {
    "name": "Parameters",
    "scope": [
      "variable.parameter"
    ],
    "settings": {
      "foreground": "$parameter",
      "fontStyle": ""
    }
  },
  {
    "name": "Namespaces and labels",
    "scope": [
      "entity.name.namespace",
      "entity.name.label"
    ],
    "settings": {
      "foreground": "$property",
      "fontStyle": ""
    }
  },
  {
    "name": "Operators and punctuation",
    "scope": [
      "keyword.operator",
      "punctuation"
    ],
    "settings": {
      "foreground": "$operator",
      "fontStyle": ""
    }
  },
  {
    "name": "Escapes and interpolation delimiters",
    "scope": [
      "constant.character.escape",
      "punctuation.section.interpolation",
      "punctuation.definition.template-expression",
      "constant.character.format.placeholder.other.python"
    ],
    "settings": {
      "foreground": "$keyword",
      "fontStyle": ""
    }
  },
  {
    "name": "Regexp operators",
    "scope": [
      "keyword.operator.regexp",
      "keyword.operator.quantifier.regexp",
      "punctuation.definition.character-class.regexp"
    ],
    "settings": {
      "foreground": "$keyword",
      "fontStyle": ""
    }
  },
  {
    "name": "Configuration sections",
    "scope": [
      "entity.name.section",
      "entity.name.namespace.site-address.caddyfile"
    ],
    "settings": {
      "foreground": "$type",
      "fontStyle": ""
    }
  },
  {
    "name": "Configuration variables",
    "scope": [
      "variable.other.systemd.specifier",
      "variable.other.systemd.environment",
      "variable.other.placeholder.caddyfile",
      "variable.other.environment.caddyfile",
      "variable.other.environment.vhs"
    ],
    "settings": {
      "foreground": "$parameter",
      "fontStyle": ""
    }
  },
  {
    "name": "Configuration paths",
    "scope": [
      "string.unquoted.path.logrotate",
      "string.quoted.path.logrotate"
    ],
    "settings": {
      "foreground": "$string",
      "fontStyle": ""
    }
  },
  {
    "name": "Configuration identities",
    "scope": [
      "entity.name.user.logrotate",
      "entity.name.group.logrotate"
    ],
    "settings": {
      "foreground": "$property",
      "fontStyle": ""
    }
  },
  {
    "name": "Configuration units",
    "scope": [
      "keyword.other.unit.logrotate",
      "keyword.other.unit.vhs"
    ],
    "settings": {
      "foreground": "$number",
      "fontStyle": ""
    }
  },
  {
    "name": "Markdown headings",
    "scope": [
      "markup.heading",
      "entity.name.section.markdown"
    ],
    "settings": {
      "foreground": "$fg",
      "fontStyle": "bold"
    }
  },
  {
    "name": "Markdown links",
    "scope": [
      "markup.underline.link",
      "markup.underline.link.image"
    ],
    "settings": {
      "foreground": "$accent",
      "fontStyle": "underline"
    }
  },
  {
    "name": "Markdown emphasis",
    "scope": [
      "markup.italic"
    ],
    "settings": {
      "foreground": "$fg",
      "fontStyle": "italic"
    }
  },
  {
    "name": "Markdown strong",
    "scope": [
      "markup.bold"
    ],
    "settings": {
      "foreground": "$fg",
      "fontStyle": "bold"
    }
  },
  {
    "name": "Markdown code",
    "scope": [
      "markup.inline.raw",
      "markup.fenced_code.block punctuation.definition"
    ],
    "settings": {
      "foreground": "$string",
      "fontStyle": ""
    }
  },
  {
    "name": "Added lines",
    "scope": [
      "markup.inserted"
    ],
    "settings": {
      "foreground": "$success",
      "fontStyle": ""
    }
  },
  {
    "name": "Removed lines",
    "scope": [
      "markup.deleted"
    ],
    "settings": {
      "foreground": "$error",
      "fontStyle": ""
    }
  },
  {
    "name": "Changed lines",
    "scope": [
      "markup.changed"
    ],
    "settings": {
      "foreground": "$warning",
      "fontStyle": ""
    }
  },
  {
    "name": "Invalid syntax",
    "scope": [
      "invalid.illegal"
    ],
    "settings": {
      "foreground": "$error",
      "fontStyle": "underline"
    }
  },
  {
    "name": "Embedded expressions",
    "scope": [
      "meta.embedded",
      "meta.template.expression"
    ],
    "settings": {
      "foreground": "$fg",
      "fontStyle": ""
    }
  },
  {
    "name": "String delimiters",
    "scope": [
      "punctuation.definition.string"
    ],
    "settings": {
      "foreground": "$string",
      "fontStyle": ""
    }
  },
  {
    "name": "Inherited types",
    "scope": [
      "entity.other.inherited-class"
    ],
    "settings": {
      "foreground": "$type",
      "fontStyle": ""
    }
  },
  {
    "name": "Word operators",
    "scope": [
      "keyword.operator.new",
      "keyword.operator.expression",
      "keyword.operator.logical.python",
      "keyword.operator.word"
    ],
    "settings": {
      "foreground": "$keyword",
      "fontStyle": ""
    }
  },
  {
    "name": "Decorators",
    "scope": [
      "entity.name.function.decorator",
      "meta.decorator entity.name.function",
      "punctuation.definition.decorator"
    ],
    "settings": {
      "foreground": "$keyword",
      "fontStyle": ""
    }
  },
  {
    "name": "C# namespace names",
    "scope": [
      "entity.name.type.namespace.cs"
    ],
    "settings": {
      "foreground": "$property",
      "fontStyle": ""
    }
  },
  {
    "name": "Go built-in types",
    "scope": [
      "storage.type.numeric.go",
      "storage.type.string.go",
      "storage.type.boolean.go",
      "storage.type.error.go",
      "storage.type.uintptr.go",
      "storage.type.byte.go",
      "storage.type.rune.go"
    ],
    "settings": {
      "foreground": "$type",
      "fontStyle": ""
    }
  },
  {
    "name": "Java types",
    "scope": [
      "storage.type.java",
      "storage.type.primitive.java",
      "storage.type.generic.java",
      "storage.type.object.array.java",
      "storage.type.primitive.array.java"
    ],
    "settings": {
      "foreground": "$type",
      "fontStyle": ""
    }
  },
  {
    "name": "Configuration keys",
    "scope": [
      "entity.name.tag.yaml",
      "keyword.other.definition.ini",
      "support.type.property-name.toml",
      "entity.other.attribute-name.toml",
      "keyword.other.key.toml",
      "keyword.other.systemd",
      "support.type.property-name.systemd",
      "keyword.other.directive.caddyfile",
      "keyword.other.directive.logrotate",
      "keyword.control.directive.caddyfile",
      "keyword.control.directive.logrotate"
    ],
    "settings": {
      "foreground": "$property",
      "fontStyle": ""
    }
  },
  {
    "name": "Python calls",
    "scope": [
      "meta.function-call.generic.python"
    ],
    "settings": {
      "foreground": "$function",
      "fontStyle": ""
    }
  },
  {
    "name": "Units and CSS colors",
    "scope": [
      "keyword.other.unit",
      "constant.other.color",
      "constant.other.color punctuation.definition.constant"
    ],
    "settings": {
      "foreground": "$number",
      "fontStyle": ""
    }
  },
  {
    "name": "CSS value constants",
    "scope": [
      "support.constant"
    ],
    "settings": {
      "foreground": "$string",
      "fontStyle": ""
    }
  },
  {
    "name": "Punctuation and embedded braces",
    "scope": [
      "meta.brace",
      "meta.brace.round",
      "punctuation.section.arguments"
    ],
    "settings": {
      "foreground": "$operator",
      "fontStyle": ""
    }
  },
  {
    "name": "XML documentation prose",
    "scope": [
      "comment.documentation.cs"
    ],
    "settings": {
      "foreground": "$comment",
      "fontStyle": ""
    }
  },
  {
    "name": "XML documentation tags",
    "scope": [
      "comment.block.documentation.cs entity.name.tag",
      "comment.documentation.name.cs"
    ],
    "settings": {
      "foreground": "$type",
      "fontStyle": ""
    }
  },
  {
    "name": "XML documentation attributes",
    "scope": [
      "comment.block.documentation.cs entity.other.attribute-name",
      "comment.documentation.attribute.name.cs"
    ],
    "settings": {
      "foreground": "$property",
      "fontStyle": ""
    }
  },
  {
    "name": "XML documentation values and quotes",
    "scope": [
      "comment.block.documentation.cs string",
      "comment.block.documentation.cs punctuation.definition.string",
      "comment.documentation.attribute.value.cs",
      "comment.documentation.attribute.quotes.cs",
      "comment.documentation.cdata.cs"
    ],
    "settings": {
      "foreground": "$string",
      "fontStyle": ""
    }
  },
  {
    "name": "XML documentation delimiters",
    "scope": [
      "comment.block.documentation.cs punctuation.definition.comment",
      "comment.block.documentation.cs punctuation.definition.tag",
      "comment.block.documentation.cs punctuation.separator",
      "comment.documentation.delimiter.cs",
      "comment.documentation.processingInstruction.cs"
    ],
    "settings": {
      "foreground": "$operator",
      "fontStyle": ""
    }
  },
  {
    "name": "XML documentation entities",
    "scope": [
      "comment.block.documentation.cs constant.character.entity",
      "comment.block.documentation.cs constant.character.entity punctuation",
      "comment.documentation.entityReference.cs"
    ],
    "settings": {
      "foreground": "$keyword",
      "fontStyle": ""
    }
  },
  {
    "name": "Comments inside XML documentation",
    "scope": [
      "comment.block.documentation.cs comment.block.cs",
      "comment.block.documentation.cs comment.block.cs punctuation.definition.comment.cs",
      "comment.documentation.comment.cs"
    ],
    "settings": {
      "foreground": "$comment",
      "fontStyle": ""
    }
  }
]
